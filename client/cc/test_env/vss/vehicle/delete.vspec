Vehicle.Test.DeleteTest:
  type: branch
  description: "Boolean property"
  deprecation: ""
  comment: "metadata test"

Vehicle.Test.DeleteTest.SensorStringValue:
  type: sensor
  description: "String property"
  deprecation: ""
  comment: "metadata test"
  allowed: ["", "sample", "abc"]
  pattern: "^[A-Za-z0-9_]*$"
  datatype: string

Vehicle.Test.DeleteTest.SensorBooleanValue:
  type: sensor
  description: "Boolean property"
  deprecation: ""
  comment: "metadata test"
  allowed: [true, false]
  pattern: ""
  datatype: boolean

Vehicle.Test.DeleteTest.ActuatorBooleanValue:
  type: actuator
  description: "Boolean property"
  deprecation: ""
  comment: "metadata test"
  allowed: [true, false]
  pattern: ""
  datatype: boolean
  


Vehicle.Test.DeleteTest.Branch:
  type: branch
  description: "Boolean property"
  deprecation: ""
  comment: "metadata test"
Vehicle.Test.DeleteTest.Branch.SensorBooleanValue:
  type: sensor
  description: "Boolean property"
  deprecation: ""
  comment: "metadata test"
  allowed: [true, false]
  pattern: ""
  datatype: boolean

Vehicle.Test.DeleteTest.Branch.ActuatorBooleanValue:
  type: actuator
  description: "Boolean property"
  deprecation: ""
  comment: "metadata test"
  allowed: [true, false]
  pattern: ""
  datatype: boolean

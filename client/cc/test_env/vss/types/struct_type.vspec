  description: "Boolean array property"
  deprecation: ""
  comment: "metadata test"
  pattern: ""
  datatype: boolean[]
Types.TestStruct.StringArrayValue:
  type: property
  description: "String array property"
  deprecation: ""
  comment: "metadata test"
  pattern: "^[A-Za-z0-9_]*$"
  datatype: string[]
